# Backend del Filtro 2 (analizador contextual):
#   groq     -> API remota de Groq (requiere GROQ_API_KEY)
#   ollama   -> LLM local vía Ollama (100% offline)
#   presidio -> Microsoft Presidio + spaCy (100% offline)
#   none     -> solo reglas del Filtro 1
#   auto     -> intenta ollama, luego presidio, luego groq y, si nada
#               está disponible, usa solo reglas
ANALYZER_BACKEND="groq"

# Backend Groq (remoto)
GROQ_API_KEY="pega_aca_tu_clave_de_groq"
ANALYZER_LLM_MODEL="openai/gpt-oss-20b"
# ANALYZER_LLM_URL="https://api.groq.com/openai/v1/chat/completions"
# ANALYZER_LLM_TIMEOUT="15"

# Backend Ollama (local/offline)
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:0.5b"
OLLAMA_TIMEOUT="60"

# Backend Presidio + spaCy (local/offline)
PRESIDIO_LANGUAGE="es"
PRESIDIO_SPACY_MODEL="es_core_news_sm"
PRESIDIO_SCORE_THRESHOLD="0.35"
